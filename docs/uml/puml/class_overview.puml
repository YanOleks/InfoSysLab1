@startuml
skinparam class {
    BackgroundColor #F8F9FA
    ArrowColor #343A40
    BorderColor #495057
}
skinparam packageStyle rectangle
skinparam linetype ortho

package "Client Layer" {
    class MainWindow <<boundary>> {
        - table_view : QTableView
        - filter_combo : QComboBox
        + refresh_files() : void
        + _setup_table() : void
    }

    class SyncManager <<control>> {
        - api : ApiClient
        - parent : QMainWindow
        - local_folder : str
        + select_folder() : str
        + scan_folder() : List[dict]
        + sync() : dict
        + run_sync() : void
    }

    class ApiClient <<boundary>> {
        - base_url : str
        - token : str
        + login(username, password) : str
        + register(username, password) : dict
        + list_files(sort_by: str, sort_order: str, filter_ext: str) : List[dict]
        + upload_file(filepath: str) : dict
        + download_file(file_id: int, save_path: str) : void
        + delete_file(file_id: int) : void
        + preview_file(file_id: int) : Tuple
        + sync(manifest: List[dict]) : dict
    }
}

package "Server API Layer (FastAPI)" {
    class auth <<module>> {
        - SECRET_KEY : str
        + hash_password(password: str) : str
        + verify_password(plain: str, hashed: str) : bool
        + create_access_token(data: dict) : str
        + get_current_user(token: str) : User
    }

    class auth_router <<router>> {
        + register_user(user_data: UserCreate) : dict
        + login_user(user_data: UserLogin) : TokenResponse
    }

    class files_router <<router>> {
        + list_files(sort_by: str, sort_order: str, filter_ext: str, user: User) : List[FileMetadata]
        + upload_file(user: User, file: UploadFile) : dict
        + download_file(user: User, file_id: int) : FileResponse
        + delete_file(user: User, file_id: int) : dict
        + preview_file(user: User, file_id: int) : dict
        + sync_files(user: User, manifest: SyncManifest) : SyncDelta
    }
}

package "Database Layer (ORM)" {
    class User <<entity>> {
        - id : int
        + username : str
        - password_hash : str
        + created_at : String
    }

    class File <<entity>> {
        - id : int
        - owner_id : int
        + filename : str
        + extension : str
        + file_size : int
        - storage_path : str
        + created_at : String
        + updated_at : String
        - uploaded_by : int
        - last_modified_by : int
    }
}

MainWindow ..> ApiClient : calls >
SyncManager *-- ApiClient : contains >

ApiClient ..> auth_router : <<HTTP REST>>
ApiClient ..> files_router : <<HTTP REST>>

auth_router ..> auth : uses >
auth_router ..> User : authenticates >
files_router ..> File : manages >
files_router ..> User : verifies owner >

User "1" *--down- "0..*" File : owns >
@enduml
