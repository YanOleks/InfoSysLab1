@startuml
skinparam class {
    BackgroundColor #FDFDFD
    ArrowColor #2C3E50
    BorderColor #34495E
}
skinparam linetype ortho

class MainWindow <<boundary>> {
    - table_view : QTableView
    - filter_combo : QComboBox
    + refresh_files() : void
    + _setup_table() : void
}

class QSortFilterProxyModel <<control>> {
    + sort(column: int, order: SortOrder) : void
}

class File <<entity>> {
    - id : int
    + filename : str
    + extension : str
    + file_size : int
    + created_at : String
    + updated_at : String
    + uploaded_by : int
    + last_modified_by : int
}

MainWindow -right-> QSortFilterProxyModel : delegates sorting >
QSortFilterProxyModel -right-> File : processes >
MainWindow .down.> File : displays >

@enduml
